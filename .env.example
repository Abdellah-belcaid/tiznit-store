# Copy this file to .env and edit the values.
# Vite reads these at build time: restart `npm run dev` (or redeploy) after changing them.

# WhatsApp number that receives the orders. Local (0640...) or international (212640...) format both work.
VITE_WHATSAPP_NUMBER=0640508854

# Phone number shown on the site (call button / footer)
VITE_PHONE_DISPLAY=06 40 50 88 54

# Social links (leave empty to hide)
VITE_FACEBOOK_URL=https://facebook.com/
VITE_INSTAGRAM_URL=

# City / address shown in the footer and About page
VITE_STORE_CITY=Casablanca, Maroc

# Currency label
VITE_CURRENCY=DH

# Delivery fee in DH added to the basket (0 = "confirmed with you") and free delivery threshold (0 = none)
VITE_DELIVERY_FEE=0
VITE_FREE_DELIVERY_FROM=0

# Seller identity shown on the legal pages (Mentions légales / CGV / Confidentialité).
# Leave empty until known: the page shows "to complete".
VITE_LEGAL_NAME=
VITE_LEGAL_STATUS=
VITE_LEGAL_ICE=
VITE_LEGAL_ADDRESS=
VITE_CONTACT_EMAIL=
VITE_CNDP_NUMBER=
